# Postgres connection strings. If your provider gives you a pooled
# (PgBouncer) connection string — Neon, Supabase, etc. — put that in
# DATABASE_URL (used at runtime) and the direct/unpooled one in DIRECT_URL
# (used only for `prisma db push`/`migrate`, which need session-level
# features PgBouncer's transaction pooling doesn't support). If you only
# have one connection string, use it for both.
DATABASE_URL="postgresql://user:password@localhost:5432/schools_compliance"
DIRECT_URL="postgresql://user:password@localhost:5432/schools_compliance"

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3004"

# SMTP (platform-wide outbound mail — used for "email me this report" and
# team invites). If unset: emails are logged to the console in development,
# and silently disabled in production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Schools Compliance <no-reply@schools-compliance.app>"

# Set to "true" to seed a demo tenant (admin@demo-school.example / password123)
# when running `npm run db:seed`. Leave unset in production.
SEED_DEMO_TENANT="false"
