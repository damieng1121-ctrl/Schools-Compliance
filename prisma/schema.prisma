// Schools Compliance — multi-tenant data model.
// Tenant = one school/trust. Every tenant-scoped model carries a `tenantId`
// and MUST be queried through the helpers in `src/lib/tenancy.ts` so tenant
// isolation can't be bypassed by an accidental unscoped query.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) connection — used at runtime.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — used for migrations/db push, which need
  // session-level features PgBouncer's transaction pooling doesn't support.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  /// URL-safe identifier, e.g. used in invite links.
  slug      String   @unique
  /// DfE unique reference number for the school, if provided
  urn       String?
  /// URL to the school's own logo, shown in place of the platform badge once set.
  logoUrl   String?
  timezone  String   @default("Europe/London")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  assessments ComplianceAssessment[]
  auditLogs   AuditLog[]
}

enum Role {
  SUPER_ADMIN // Platform staff, cross-tenant — belongs to no single school
  ADMIN // Can manage users/settings and edit assessments
  MEMBER // Can view and edit assessments
}

model User {
  id       String  @id @default(cuid())
  /// Null only for SUPER_ADMIN — every ADMIN/MEMBER belongs to exactly one school.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email        String  @unique
  name         String?
  passwordHash String
  role         Role    @default(MEMBER)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessmentsReviewed ComplianceAssessment[]
  auditLogs           AuditLog[]

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// DfE "Meeting digital and technology standards" compliance checklist
//
// ComplianceStandard/ComplianceItem form a global catalogue (shared across
// all tenants, seeded from prisma/seed.ts). ComplianceAssessment is the
// per-tenant record of where a school stands against each item.
// ---------------------------------------------------------------------------

model ComplianceStandard {
  id          String  @id @default(cuid())
  /// Stable slug matching the DfE standard, e.g. "cyber-security"
  code        String  @unique
  title       String
  description String  @db.Text
  officialUrl String?
  order       Int     @default(0)

  items ComplianceItem[]
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model ComplianceItem {
  id          String             @id @default(cuid())
  standardId  String
  standard    ComplianceStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  code        String
  title       String
  description String             @db.Text
  guidance    String?            @db.Text
  order       Int                @default(0)
  /// How much this item matters relative to others under the same standard
  priority    Priority           @default(MEDIUM)
  /// Deep link to the specific DfE guidance sub-page for this item, if more specific than the standard's officialUrl
  govLink     String?

  assessments ComplianceAssessment[]

  @@unique([standardId, code])
}

enum ComplianceStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

model ComplianceAssessment {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId   String
  item     ComplianceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  status        ComplianceStatus @default(NOT_STARTED)
  evidenceNotes String?          @db.Text
  evidenceUrl   String?

  reviewedById  String?
  reviewedBy    User?     @relation(fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  nextReviewDue DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, itemId])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Audit log — records who changed what, for accountability.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}
