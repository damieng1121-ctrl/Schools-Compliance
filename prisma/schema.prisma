// Schools Compliance — multi-tenant data model.
// Tenant = one school/trust. Every tenant-scoped model carries a `tenantId`
// and MUST be queried through the helpers in `src/lib/tenancy.ts` so tenant
// isolation can't be bypassed by an accidental unscoped query.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) connection — used at runtime.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — used for migrations/db push, which need
  // session-level features PgBouncer's transaction pooling doesn't support.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  /// URL-safe identifier, e.g. used in invite links.
  slug      String   @unique
  /// DfE unique reference number for the school, if provided
  urn       String?
  /// URL to the school's own logo, shown in place of the platform badge once set.
  logoUrl   String?
  timezone  String   @default("Europe/London")
  isActive  Boolean  @default(true)
  /// Designated Safeguarding Lead — who Filtering & Monitoring check reports get emailed to.
  dslName   String?
  dslEmail  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  assessments     ComplianceAssessment[]
  filteringChecks FilteringCheck[]
  auditLogs       AuditLog[]
}

enum Role {
  SUPER_ADMIN // Platform staff, cross-tenant — belongs to no single school
  ADMIN // Can manage users/settings and edit assessments
  MEMBER // Can view and edit assessments
}

model User {
  id       String  @id @default(cuid())
  /// Null only for SUPER_ADMIN — every ADMIN/MEMBER belongs to exactly one school.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email        String  @unique
  name         String?
  passwordHash String
  role         Role    @default(MEMBER)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessmentsReviewed      ComplianceAssessment[]
  filteringChecksPerformed FilteringCheck[]
  auditLogs                AuditLog[]

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// DfE "Meeting digital and technology standards" compliance checklist
//
// ComplianceStandard/ComplianceItem form a global catalogue (shared across
// all tenants, seeded from prisma/seed.ts). ComplianceAssessment is the
// per-tenant record of where a school stands against each item.
// ---------------------------------------------------------------------------

model ComplianceStandard {
  id          String  @id @default(cuid())
  /// Stable slug matching the DfE standard, e.g. "cyber-security"
  code        String  @unique
  title       String
  description String  @db.Text
  officialUrl String?
  order       Int     @default(0)

  items ComplianceItem[]
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model ComplianceItem {
  id          String             @id @default(cuid())
  standardId  String
  standard    ComplianceStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  code        String
  title       String
  description String             @db.Text
  guidance    String?            @db.Text
  order       Int                @default(0)
  /// How much this item matters relative to others under the same standard
  priority    Priority           @default(MEDIUM)
  /// Deep link to the specific DfE guidance sub-page for this item, if more specific than the standard's officialUrl
  govLink     String?

  assessments ComplianceAssessment[]

  @@unique([standardId, code])
}

enum ComplianceStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLIANT
  NON_COMPLIANT
  NOT_APPLICABLE
}

model ComplianceAssessment {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId   String
  item     ComplianceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  status        ComplianceStatus @default(NOT_STARTED)
  evidenceNotes String?          @db.Text
  evidenceUrl   String?

  reviewedById  String?
  reviewedBy    User?     @relation(fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  nextReviewDue DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, itemId])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Filtering & Monitoring checks — technicians (currently: SUPER_ADMIN users)
// log a visit against a school, testing one or more devices/user types
// against a fixed set of checks, then can email the report to the school's
// Designated Safeguarding Lead (Tenant.dslEmail).
//
// FilteringCheckItem is a small global catalogue (seeded), mirroring the
// ComplianceStandard/Item pattern above. FilteringCheck is one visit;
// FilteringCheckDevice is one device/user/location tested during that
// visit; FilteringCheckResult is the outcome of one catalogue item against
// one device.
// ---------------------------------------------------------------------------

model FilteringCheckItem {
  id       String  @id @default(cuid())
  /// Stable slug, e.g. "categories-blocked"
  code     String  @unique
  title    String
  guidance String? @db.Text
  order    Int     @default(0)

  results FilteringCheckResult[]
}

model FilteringCheck {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  performedAt   DateTime @default(now())
  /// Overall notes for the visit, separate from per-device/per-check action notes.
  notes         String?  @db.Text

  sentToDslAt DateTime?

  devices FilteringCheckDevice[]

  createdAt DateTime @default(now())

  @@index([tenantId, performedAt])
}

enum CheckOutcome {
  PASS
  FAIL
  NOT_APPLICABLE
  NOT_TESTED
}

model FilteringCheckDevice {
  id               String         @id @default(cuid())
  filteringCheckId String
  filteringCheck   FilteringCheck @relation(fields: [filteringCheckId], references: [id], onDelete: Cascade)
  /// What was tested, e.g. "Staff laptop — reception", "Student login — Y7", "Guest network"
  label            String
  order            Int            @default(0)

  results FilteringCheckResult[]
}

model FilteringCheckResult {
  id       String               @id @default(cuid())
  deviceId String
  device   FilteringCheckDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  itemId   String
  item     FilteringCheckItem   @relation(fields: [itemId], references: [id])

  outcome     CheckOutcome @default(NOT_TESTED)
  actionNotes String?      @db.Text

  @@unique([deviceId, itemId])
}

// ---------------------------------------------------------------------------
// Audit log — records who changed what, for accountability.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}
